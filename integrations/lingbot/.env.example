# LingBot-World v2 setup environment variables
# Copy this to .env and fill in your values

# Hugging Face token for accessing checkpoint repo
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override HF cache location (default: ~/.cache/huggingface)
# HF_HOME=/path/to/cache/huggingface

# Optional: Override flashdreams cache location (default: ~/.cache/flashdreams)
# FLASHDREAMS_CACHE_DIR=/path/to/cache/flashdreams
